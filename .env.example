# --- App ---
APP_HOST=127.0.0.1
APP_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
DATA_DIR=./data
WORK_DIR=./work
# Pasta (ex.: dentro do seu vault do Obsidian) onde os resumos .md são gravados
OBSIDIAN_DIR=./data/obsidian

# Pasta raiz no Drive (ID da pasta, não a URL)
GOOGLE_DRIVE_FOLDER_ID=

# --- Google Drive (OAuth desktop) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/drive/callback

# --- Qual IA usar: gemini | grok | claude | copilot ---
AI_PROVIDER=gemini
AI_MODEL=

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Grok (xAI) ---
GROK_API_KEY=
GROK_MODEL=grok-2-vision-latest
GROK_BASE_URL=https://api.x.ai/v1

# --- Claude (Anthropic) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5

# --- Copilot / GitHub Models (OpenAI-compatible) ---
COPILOT_API_KEY=
COPILOT_MODEL=gpt-4o
COPILOT_BASE_URL=https://models.github.ai/inference

# Tamanho mínimo do MP4 (bytes) para entrar na lista; 1073741824 = 1 GiB
MIN_VIDEO_BYTES=1073741824

# --- Whisper ---
WHISPER_MODEL=medium
WHISPER_LANGUAGE=pt

# --- Compressão (depois da transcrição; o original local sai no fim da aula) ---
# Ajustes na tela Vídeo gravam por cima destes valores em data/runtime.json.
# COMPRESS_DELETE_ORIGINAL=false guarda a cópia da câmera em work/ (o Drive já tem o original).
COMPRESS_ENABLED=true
COMPRESS_CRF=23
COMPRESS_PRESET=veryfast
COMPRESS_MAX_HEIGHT=0
COMPRESS_CODEC=h264
COMPRESS_AUDIO=copy
COMPRESS_AUDIO_BITRATE=128k
COMPRESS_DELETE_ORIGINAL=true
COMPRESS_UPLOAD_DRIVE=false
COMPRESS_DURATION_TOLERANCE=1

# Versículos (ARC) e letras no mesmo encode da compressão.
# OVERLAY_WAIT_HOURS=0 não espera: o vídeo segue com o que já foi encontrado.
OVERLAY_ENABLED=true
OVERLAY_WAIT_HOURS=24


# --- Publicar no Bunny Stream / Maná Bíblico (opcional; desligado por padrão) ---
# PUBLISH_ENABLED=true inclui o passo no fim do pipeline. O comando `cli publish` também usa estas chaves.
# Só a versão reduzida ({stem}.compressed.mp4) vai ao Bunny. O MP4 original no Drive não é apagado.
PUBLISH_ENABLED=false
# Transcodifica para 720p H.264 antes do envio (cópia em work/publish/). O arquivo de origem fica.
PUBLISH_TRANSCODE_720=false
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
# MANA_PUBLISH_ENABLED tenta gravar o rascunho. Sem MANA_SESSION_TOKEN o cliente não chama a API.
# MANA_SESSION_TOKEN é o session_token do login Google (POST /api/auth/session), não uma chave de máquina.
# O mapa nome → speaker_id também pode ficar em data/publish/speakers.json. Ver docs/mana-publish.md.
MANA_PUBLISH_ENABLED=false
# MANA_PIPELINE_LESSONS=true usa PUT /api/pipeline/lessons/{drive_file_id} quando existir.
MANA_PIPELINE_LESSONS=false
# MANA_PIPELINE_TOKEN é a credencial de máquina; não use MANA_SESSION_TOKEN nesse modo.
MANA_PIPELINE_TOKEN=
MANA_API_URL=
MANA_SESSION_TOKEN=
MANA_SPEAKER_MAP=
