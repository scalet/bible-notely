# --- App ---
APP_HOST=127.0.0.1
APP_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
DATA_DIR=./data
WORK_DIR=./work
# Pasta (ex.: dentro do seu vault do Obsidian) onde os resumos .md são gravados
OBSIDIAN_DIR=./data/obsidian

# Pasta raiz no Drive (ID da pasta, não a URL)
GOOGLE_DRIVE_FOLDER_ID=

# --- Google Drive (OAuth desktop) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/drive/callback

# --- Qual IA usar: gemini | grok | claude | copilot ---
AI_PROVIDER=gemini
AI_MODEL=

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Grok (xAI) ---
GROK_API_KEY=
GROK_MODEL=grok-2-vision-latest
GROK_BASE_URL=https://api.x.ai/v1

# --- Claude (Anthropic) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5

# --- Copilot / GitHub Models (OpenAI-compatible) ---
COPILOT_API_KEY=
COPILOT_MODEL=gpt-4o
COPILOT_BASE_URL=https://models.github.ai/inference

# Tamanho mínimo do MP4 (bytes) para entrar na lista; 1073741824 = 1 GiB
MIN_VIDEO_BYTES=1073741824

# --- Whisper ---
WHISPER_MODEL=medium
WHISPER_LANGUAGE=pt

# --- Publicar no Bunny Stream / Maná Bíblico (opcional; desligado por padrão) ---
# PUBLISH_ENABLED=true inclui o passo no fim do pipeline. O comando `cli publish` também usa estas chaves.
# O MP4 original no Drive não é apagado.
PUBLISH_ENABLED=false
# Transcodifica para 720p H.264 antes do envio (cópia em work/publish/). O arquivo de origem fica.
PUBLISH_TRANSCODE_720=false
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
# MANA_PUBLISH_ENABLED chama o contrato de rascunho (docs/mana-publish.md). A API atual ainda não tem esse endpoint.
MANA_PUBLISH_ENABLED=false
MANA_API_URL=
MANA_API_TOKEN=
