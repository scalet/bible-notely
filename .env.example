# --- App ---
APP_HOST=127.0.0.1
APP_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
DATA_DIR=./data
WORK_DIR=./work
# Pasta (ex.: dentro do seu vault do Obsidian) onde os resumos .md são gravados
OBSIDIAN_DIR=./data/obsidian

# Pasta raiz no Drive (ID da pasta, não a URL)
GOOGLE_DRIVE_FOLDER_ID=

# --- Google Drive (OAuth desktop) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/drive/callback

# --- Qual IA usar: gemini | grok | claude | copilot ---
AI_PROVIDER=gemini
AI_MODEL=

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Grok (xAI) ---
GROK_API_KEY=
GROK_MODEL=grok-2-vision-latest
GROK_BASE_URL=https://api.x.ai/v1

# --- Claude (Anthropic) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5

# --- Copilot / GitHub Models (OpenAI-compatible) ---
COPILOT_API_KEY=
COPILOT_MODEL=gpt-4o
COPILOT_BASE_URL=https://models.github.ai/inference

# Tamanho mínimo do MP4 (bytes) para entrar na lista; 1073741824 = 1 GiB
MIN_VIDEO_BYTES=1073741824

# --- Whisper ---
WHISPER_MODEL=medium
WHISPER_LANGUAGE=pt
